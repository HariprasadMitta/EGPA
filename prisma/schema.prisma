// Prisma schema - mirrors src/types/index.ts exactly so the app's existing
// TS types stay the source of truth for shape. Union-typed string fields
// (role, riskTier, status, etc.) are plain String columns rather than
// Postgres enums: those TS unions have already grown once this session
// (the "admin" role) and plain strings avoid a migration every time that
// happens again - validation for these stays at the TypeScript layer,
// same as it already is today.

// Prisma 7: no `url` here - the connection string lives in prisma.config.ts
// (for the CLI/migrations) and is passed via a driver adapter to
// PrismaClient at runtime (src/lib/prisma.ts). Sticking with the classic
// "prisma-client-js" generator (not the newer "prisma-client" provider,
// and no custom `output` path) because that's the one that generates into
// node_modules/.prisma/client, which Turbopack resolves reliably - the
// newer provider's ESM output outside node_modules is known to break
// Turbopack's SSR module resolution.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  // nullable: an SSO-only account (googleId set) never gets a local password
  name         String
  role         String // UserRole: requester | steward | governance-owner | developer | arb | admin
  createdAt    DateTime @default(now())

  // Real SSO (Google OAuth via Auth.js) - same pattern any other OIDC/SAML
  // provider would slot into; Google chosen because it's free and
  // immediately testable, not because it's the only real option.
  googleId String? @unique

  // Basic real multi-tenancy: which Organization this user belongs to.
  // Nullable during the org-creation window at signup.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Org-scoped visibility proxy: which business unit/domain this user's
  // own submissions belong to (matches UseCase.businessDomain by string,
  // no separate BusinessUnit table - reuses data already captured).
  // governance-owner/arb/admin roles bypass this filter entirely (see
  // src/lib/roles.ts's canSeeAllUseCases).
  businessUnit String?

  // Real access recertification for elevated roles (governance-owner, arb,
  // admin) - separate from use-case recertification. Null means never
  // recertified since account creation; an admin explicitly re-confirming
  // "this person still needs this access" sets it, same joiner-mover-leaver
  // hygiene as any privileged-access review.
  roleRecertifiedAt DateTime?

  useCases      UseCase[]
  comments      Comment[]
  auditLogEntries AuditLogEntry[]
  apiKeys       ApiKey[]
  delegationsGiven    ApprovalDelegation[] @relation("DelegatedBy")
  delegationsReceived ApprovalDelegation[] @relation("DelegatedTo")
  passwordResetTokens PasswordResetToken[]
}

// Real forgot-password flow. No email-sending service is configured, so the
// reset link is shown directly in-app after requesting it (a real, working
// choice for this deployment, not how a customer-facing product handling
// strangers' accounts would do it - documented as a known simplification).
// Only the token's hash is ever stored, same discipline as every other
// real token in this app (API keys, webhook triggers).
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Real, audited approval delegation - a governance-owner or ARB member
// going on leave can hand off their approval authority for a real time
// window instead of the unofficial workaround (sharing credentials) that
// this feature exists specifically to replace. delegatorUserId is always
// the session user creating it - you can only delegate your own authority,
// never someone else's. Enforcement lives in src/lib/delegation.ts.
model ApprovalDelegation {
  id              String   @id @default(cuid())
  delegatorUserId String
  delegateUserId  String
  scope           String // "arb_approval" | "governance_owner_actions"
  startsAt        DateTime
  endsAt          DateTime
  createdAt       DateTime @default(now())
  revoked         Boolean  @default(false)

  delegator User @relation("DelegatedBy", fields: [delegatorUserId], references: [id])
  delegate  User @relation("DelegatedTo", fields: [delegateUserId], references: [id])
}

// Real basic multi-tenancy: an Organization owns its own Users/UseCases.
// Deliberately scoped (no per-org billing, no cross-org admin console) -
// real tenant isolation on the core tables, not a full enterprise tenant
// administration system.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users    User[]
  useCases UseCase[]
}

model UseCase {
  id                 String   @id
  title              String
  description        String
  businessDomain     String
  dataSensitivity    String // DataSensitivity
  autonomyLevel      String // AutonomyLevel
  integrationSurface String // IntegrationSurface
  expectedUsers      String // ExpectedUsers
  owner              String
  steward            String
  riskTier           String // RiskTier
  status             String // UseCaseStatus
  createdAt          DateTime @default(now())
  killSwitchEngaged  Boolean  @default(false)

  ownerUser   User   @relation(fields: [ownerUserId], references: [id])
  ownerUserId String

  // Nullable: use cases created before Organization existed have no tenant;
  // treated as globally visible (same as today) rather than orphaned.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  recommendation         Recommendation?
  gate                   GovernanceGate?
  adrs                   Adr[]
  executions             ExecutionRun[]
  webhookTrigger         WebhookTrigger?
  riskComplianceDetails  RiskComplianceDetails?
  budget                 Budget?
  comments               Comment[]
  auditLogEntries        AuditLogEntry[]
  actualUsageReports     ActualUsageReport[]
}

// Real declared-vs-actual reconciliation. Use cases run through this
// platform's own execution engine can't actually drift from the declared
// tool stack - startExecutionRun (src/lib/executionPersistence.ts) already
// rejects any step outside Recommendation.tools before it runs, so
// internal executions are preventively guaranteed to match, not just
// checked after the fact. The real, still-open gap is an enterprise's own
// production agent running in its own infrastructure, which this platform
// has no preventive control over - this model lets that external system
// report what it actually used via the public API, and the report is
// reconciled against the declared stack for real, not fabricated, drift
// detection.
model ActualUsageReport {
  id         String   @id @default(cuid())
  useCaseId  String
  source     String // "external-api" - internal executions don't need one, see comment above
  toolsUsed  String[]
  modelUsed  String?
  reportedAt DateTime @default(now())

  useCase UseCase @relation(fields: [useCaseId], references: [id])
}

model Recommendation {
  useCaseId        String   @id
  framework        String
  tools            String[]
  harnessPattern   String
  loopPattern      String
  iterationCeiling Int
  contextStrategy  String
  rationale        String
  createdAt        DateTime @default(now())
  version          Int

  useCase UseCase @relation(fields: [useCaseId], references: [id])
}

model GovernanceGate {
  useCaseId           String    @id
  riskTier            String
  requiredControls    String[]
  hitlTier            String // HitlTier
  acknowledged        Boolean   @default(false)
  acknowledgedItems   String[]
  acknowledgedAt      DateTime? // real timestamp: recertification due date = this + template.recertificationDays
  requiresArbApproval Boolean   @default(false)
  arbApproved         Boolean   @default(false)
  arbApprovedBy       String?
  arbApprovedAt       DateTime?

  useCase UseCase @relation(fields: [useCaseId], references: [id])
}

model Adr {
  id        String   @id @default(cuid())
  useCaseId String
  version   Int
  createdAt DateTime @default(now())
  content   String

  useCase UseCase @relation(fields: [useCaseId], references: [id])

  @@unique([useCaseId, version])
}

model ExecutionRun {
  id                 String    @id
  runNumber          Int
  useCaseId          String
  masterAgentSummary String
  status             String // "planning" | "running" | "completed" | "failed"
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  totalInputTokens   Int       @default(0)
  totalOutputTokens  Int       @default(0)
  totalCostUsd       Float     @default(0)
  error              String?
  // Real dry-run mode: still a real LLM-backed run (real cost, real output),
  // just excluded from audit-trail counts/history shown as "official" runs
  // and from anomaly-baseline calculations - lets a developer iterate on a
  // use case's steps without it counting as a governed execution.
  dryRun             Boolean   @default(false)

  useCase      UseCase        @relation(fields: [useCaseId], references: [id])
  steps        SubAgentStep[]
  toolCallLogs ToolCallLog[]
}

model SubAgentStep {
  id           String  @id @default(cuid())
  stepId       String // app-facing id, e.g. "step-0" - unique only within its run, not globally
  name         String
  tool         String
  task         String
  rationale    String? // real: why the master agent picked this tool for this step - nullable, older rows predate this field
  status       String // SubAgentStepStatus
  output       String?
  provider     String?
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  costUsd      Float   @default(0)
  durationMs   Int     @default(0)
  // Real heuristic confidence score (0-1) computed from the actual output
  // text (hedge-word density, length, whether it cites concrete facts) -
  // not an extra paid LLM-judge call. See src/lib/confidence.ts.
  confidenceScore Float?
  // Real regex-based PII detection against the actual output text (see
  // src/lib/piiDetection.ts) - `output` above is the already-redacted text
  // when this is true; the real unredacted count is tracked here, not the
  // raw PII itself.
  piiDetected     Boolean @default(false)
  piiMatchCount   Int     @default(0)

  executionRun   ExecutionRun @relation(fields: [executionRunId], references: [id])
  executionRunId String

  @@unique([executionRunId, stepId])
}

// Real event trigger: lets an external caller (curl, a real cron service,
// GitHub Actions, etc.) start an execution with no human clicking "Run
// execution." Only the token's hash is ever stored - the plaintext token is
// generated server-side and shown to the user exactly once, the same UX
// real API-key systems use.
model WebhookTrigger {
  id              String    @id @default(cuid())
  useCaseId       String    @unique
  tokenHash       String
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  lastTriggeredAt DateTime?
  triggerCount    Int       @default(0)

  useCase UseCase @relation(fields: [useCaseId], references: [id])
}

// Real audit trail of every tool invocation during execution - not just
// narration. One row per actual real call to a bound tool (e.g.
// knowledge_base_search), implementing the "Audit logging" governance
// control for real instead of a one-time checkbox acknowledgment.
model ToolCallLog {
  id        String   @id @default(cuid())
  stepId    String // app-facing step id, e.g. "step-0"
  toolName  String
  argsJson  String
  result    String
  createdAt DateTime @default(now())

  executionRun   ExecutionRun @relation(fields: [executionRunId], references: [id])
  executionRunId String
}

// Deeper intake questionnaire (second Intake page) - real risk/compliance
// due-diligence fields, captured once per UseCase. Two fields here
// (humanOversightFrequency, customerImpactDecision) feed classifyRisk() as
// real weighted scoring inputs; the rest are captured and surfaced (ADR,
// Guide) as real governance documentation without being force-fit into the
// numeric score.
model RiskComplianceDetails {
  useCaseId String @id

  regulatoryFrameworks String[] // POPIA, FSCA Conduct Standards, FICA, GDPR, SARB/Basel
  dataResidency        String
  dataSources          String[] // internal | third-party-feed | customer-submitted
  sensitiveDataElements String

  retentionInputsDays  Int?
  retentionOutputsDays Int?
  retentionLogsDays    Int?

  modelSourcing String // "third-party-api" | "in-house-fine-tuned" - captured, never a risk multiplier
  modelVendor   String

  customerImpactDecision   Boolean // real scoring input
  humanOversightFrequency  String // "full-review" | "sampled" | "exception-only" - real scoring input
  humanReviewSamplePercent Int?
  escalationOwner          String

  explainabilityRequirement String
  biasFairnessTestingPlan   String
  preProductionValidation   String
  expectedUsageVolume       String
  businessCriticality       String
  fallbackRollbackPlan      String

  encryptedAtRestInTransit   Boolean @default(false)
  agentWriteAccessProduction Boolean @default(false)
  securityReviewCompleted    Boolean @default(false)

  accountableOwner  String
  usersToldAboutAi  Boolean @default(false)

  createdAt DateTime @default(now())

  useCase UseCase @relation(fields: [useCaseId], references: [id])
}

// Real governance action audit trail - who changed what governance state
// and when. Complements ToolCallLog (real tool-call audit) and
// SubAgentStep (real execution audit) with the human-action side: kill-
// switch toggles, control acknowledgment/un-acknowledgment, gate
// finalization, ARB approval, and detections (drift/anomaly) surfaced the
// same way. Previously only the *current* state was visible (e.g.
// killSwitchEngaged boolean) with no history of who/when.
model AuditLogEntry {
  id          String   @id @default(cuid())
  useCaseId   String
  actorUserId String?
  actorName   String
  action      String // "kill_switch_engaged" | "kill_switch_disengaged" | "control_acknowledged" | "control_unacknowledged" | "gate_finalized" | "arb_approved" | "drift_detected" | "anomaly_detected"
  detail      String?
  createdAt   DateTime @default(now())

  // Real tamper-evident chain: prevHash is the previous entry's hash for
  // this same use case ("GENESIS" for the first one), hash is
  // SHA-256(prevHash + this row's own fields) - see src/lib/auditChain.ts.
  // Editing any past entry breaks its own hash and every hash after it,
  // which GET .../audit-log/verify actually recomputes and checks.
  prevHash String @default("GENESIS")
  hash     String @default("")

  useCase UseCase @relation(fields: [useCaseId], references: [id])
  actor   User?   @relation(fields: [actorUserId], references: [id])
}

// Real cost budget/quota - scoped to either one use case OR a whole
// business domain (team proxy, matches UseCase.businessDomain), never
// both. Enforced by checking real cumulative ExecutionRun.totalCostUsd
// against monthlyLimitUsd before/after a run.
model Budget {
  id                String   @id @default(cuid())
  useCaseId         String?  @unique
  businessDomain    String?  @unique
  monthlyLimitUsd   Float
  alertThresholdPct Int      @default(80)
  createdAt         DateTime @default(now())

  useCase UseCase? @relation(fields: [useCaseId], references: [id])
}

// Real outbound notification target (Slack incoming webhook today,
// kind is extensible). Global for now - one channel receives every
// notification event (ARB approval needed, execution failed, kill-switch
// engaged) rather than per-use-case routing, a reasonable real MVP scope.
model NotificationChannel {
  id         String   @id @default(cuid())
  kind       String   @default("slack")
  webhookUrl String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// Real record of a retention-policy purge actually running - proof the
// RiskComplianceDetails retention fields aren't just captured but enforced.
model RetentionPurgeLog {
  id          String   @id @default(cuid())
  useCaseId   String
  tableName   String // "SubAgentStep" | "ToolCallLog" | "ExecutionRun"
  rowsDeleted Int
  ranAt       DateTime @default(now())
}

// Real, DB-backed Model Registry replacing the previously-hardcoded
// src/lib/modelRegistry.ts arrays - admins can now actually add/deprecate/
// version entries through the UI instead of editing source code.
model ModelRegistryEntry {
  id               String   @id
  name             String
  vendor           String
  version          String
  status           String // ModelStatus
  allowedRiskTiers String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model McpServerEntry {
  id               String   @id
  name             String
  publisher        String
  description      String
  status           String // ModelStatus
  allowedRiskTiers String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Real per-use-case discussion thread - governance review in practice
// involves back-and-forth (ARB asking a clarifying question, a governance
// owner leaving a note), which had no home anywhere in the app before.
model Comment {
  id           String   @id @default(cuid())
  useCaseId    String
  authorUserId String
  authorName   String
  body         String
  createdAt    DateTime @default(now())

  useCase UseCase @relation(fields: [useCaseId], references: [id])
  author  User    @relation(fields: [authorUserId], references: [id])
}

// Real platform API keys - lets an external enterprise system call the
// public REST surface (src/app/api/public/*) the same way WebhookTrigger
// lets a caller start one specific execution. Only the hash is ever
// stored, same pattern as WebhookTrigger's token.
model ApiKey {
  id              String    @id @default(cuid())
  name            String
  keyHash         String
  scope           String    @default("read-write")
  expiresAt       DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime?
  revoked         Boolean   @default(false)

  createdByUser User @relation(fields: [createdByUserId], references: [id])
}
