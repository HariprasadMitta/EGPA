// Prisma schema - mirrors src/types/index.ts exactly so the app's existing
// TS types stay the source of truth for shape. Union-typed string fields
// (role, riskTier, status, etc.) are plain String columns rather than
// Postgres enums: those TS unions have already grown once this session
// (the "admin" role) and plain strings avoid a migration every time that
// happens again - validation for these stays at the TypeScript layer,
// same as it already is today.

// Prisma 7: no `url` here - the connection string lives in prisma.config.ts
// (for the CLI/migrations) and is passed via a driver adapter to
// PrismaClient at runtime (src/lib/prisma.ts). Sticking with the classic
// "prisma-client-js" generator (not the newer "prisma-client" provider,
// and no custom `output` path) because that's the one that generates into
// node_modules/.prisma/client, which Turbopack resolves reliably - the
// newer provider's ESM output outside node_modules is known to break
// Turbopack's SSR module resolution.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String // UserRole: requester | steward | governance-owner | developer | arb | admin
  createdAt    DateTime @default(now())

  useCases UseCase[]
}

model UseCase {
  id                 String   @id
  title              String
  description        String
  businessDomain     String
  dataSensitivity    String // DataSensitivity
  autonomyLevel      String // AutonomyLevel
  integrationSurface String // IntegrationSurface
  expectedUsers      String // ExpectedUsers
  owner              String
  steward            String
  riskTier           String // RiskTier
  status             String // UseCaseStatus
  createdAt          DateTime @default(now())
  killSwitchEngaged  Boolean  @default(false)

  ownerUser   User   @relation(fields: [ownerUserId], references: [id])
  ownerUserId String

  recommendation         Recommendation?
  gate                   GovernanceGate?
  adrs                   Adr[]
  executions             ExecutionRun[]
  webhookTrigger         WebhookTrigger?
  riskComplianceDetails  RiskComplianceDetails?
}

model Recommendation {
  useCaseId        String   @id
  framework        String
  tools            String[]
  harnessPattern   String
  loopPattern      String
  iterationCeiling Int
  contextStrategy  String
  rationale        String
  createdAt        DateTime @default(now())
  version          Int

  useCase UseCase @relation(fields: [useCaseId], references: [id])
}

model GovernanceGate {
  useCaseId           String    @id
  riskTier            String
  requiredControls    String[]
  hitlTier            String // HitlTier
  acknowledged        Boolean   @default(false)
  acknowledgedItems   String[]
  requiresArbApproval Boolean   @default(false)
  arbApproved         Boolean   @default(false)
  arbApprovedBy       String?
  arbApprovedAt       DateTime?

  useCase UseCase @relation(fields: [useCaseId], references: [id])
}

model Adr {
  id        String   @id @default(cuid())
  useCaseId String
  version   Int
  createdAt DateTime @default(now())
  content   String

  useCase UseCase @relation(fields: [useCaseId], references: [id])

  @@unique([useCaseId, version])
}

model ExecutionRun {
  id                 String    @id
  runNumber          Int
  useCaseId          String
  masterAgentSummary String
  status             String // "planning" | "running" | "completed" | "failed"
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  totalInputTokens   Int       @default(0)
  totalOutputTokens  Int       @default(0)
  totalCostUsd       Float     @default(0)
  error              String?

  useCase      UseCase        @relation(fields: [useCaseId], references: [id])
  steps        SubAgentStep[]
  toolCallLogs ToolCallLog[]
}

model SubAgentStep {
  id           String  @id @default(cuid())
  stepId       String // app-facing id, e.g. "step-0" - unique only within its run, not globally
  name         String
  tool         String
  task         String
  status       String // SubAgentStepStatus
  output       String?
  provider     String?
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  costUsd      Float   @default(0)
  durationMs   Int     @default(0)

  executionRun   ExecutionRun @relation(fields: [executionRunId], references: [id])
  executionRunId String

  @@unique([executionRunId, stepId])
}

// Real event trigger: lets an external caller (curl, a real cron service,
// GitHub Actions, etc.) start an execution with no human clicking "Run
// execution." Only the token's hash is ever stored - the plaintext token is
// generated server-side and shown to the user exactly once, the same UX
// real API-key systems use.
model WebhookTrigger {
  id              String    @id @default(cuid())
  useCaseId       String    @unique
  tokenHash       String
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  lastTriggeredAt DateTime?
  triggerCount    Int       @default(0)

  useCase UseCase @relation(fields: [useCaseId], references: [id])
}

// Real audit trail of every tool invocation during execution - not just
// narration. One row per actual real call to a bound tool (e.g.
// knowledge_base_search), implementing the "Audit logging" governance
// control for real instead of a one-time checkbox acknowledgment.
model ToolCallLog {
  id        String   @id @default(cuid())
  stepId    String // app-facing step id, e.g. "step-0"
  toolName  String
  argsJson  String
  result    String
  createdAt DateTime @default(now())

  executionRun   ExecutionRun @relation(fields: [executionRunId], references: [id])
  executionRunId String
}

// Deeper intake questionnaire (second Intake page) - real risk/compliance
// due-diligence fields, captured once per UseCase. Two fields here
// (humanOversightFrequency, customerImpactDecision) feed classifyRisk() as
// real weighted scoring inputs; the rest are captured and surfaced (ADR,
// Guide) as real governance documentation without being force-fit into the
// numeric score.
model RiskComplianceDetails {
  useCaseId String @id

  regulatoryFrameworks String[] // POPIA, FSCA Conduct Standards, FICA, GDPR, SARB/Basel
  dataResidency        String
  dataSources          String[] // internal | third-party-feed | customer-submitted
  sensitiveDataElements String

  retentionInputsDays  Int?
  retentionOutputsDays Int?
  retentionLogsDays    Int?

  modelSourcing String // "third-party-api" | "in-house-fine-tuned" - captured, never a risk multiplier
  modelVendor   String

  customerImpactDecision   Boolean // real scoring input
  humanOversightFrequency  String // "full-review" | "sampled" | "exception-only" - real scoring input
  humanReviewSamplePercent Int?
  escalationOwner          String

  explainabilityRequirement String
  biasFairnessTestingPlan   String
  preProductionValidation   String
  expectedUsageVolume       String
  businessCriticality       String
  fallbackRollbackPlan      String

  encryptedAtRestInTransit   Boolean @default(false)
  agentWriteAccessProduction Boolean @default(false)
  securityReviewCompleted    Boolean @default(false)

  accountableOwner  String
  usersToldAboutAi  Boolean @default(false)

  createdAt DateTime @default(now())

  useCase UseCase @relation(fields: [useCaseId], references: [id])
}
