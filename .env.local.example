# Primary provider to try first. One of: anthropic | openrouter | groq | gemini
# If the primary call fails, the server automatically falls back through the
# other configured providers in this order: anthropic -> openrouter -> groq -> gemini.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Model Builder (Developer-only page) - Hugging Face OAuth ("Sign in with
# Hugging Face"). Register an app at huggingface.co/settings/applications/new
# with redirect URI matching HF_REDIRECT_URI below. OpenRouter needs no env
# vars here - its PKCE connect flow requires no pre-registered app.
HF_CLIENT_ID=
HF_CLIENT_SECRET=
HF_REDIRECT_URI=http://localhost:3000/api/mlops/hf/callback

# Mirrors of the two public values above - Next.js only exposes NEXT_PUBLIC_*
# vars to the browser, so the client-side "Sign in with Hugging Face" button
# needs its own copies (never put HF_CLIENT_SECRET here).
NEXT_PUBLIC_HF_CLIENT_ID=
NEXT_PUBLIC_HF_REDIRECT_URI=http://localhost:3000/api/mlops/hf/callback

# Database (Phase 1 of the enterprise rearchitecture) - a free Neon Postgres
# connection string from https://neon.tech (project settings -> Connect).
DATABASE_URL=

# Real authentication (Phase 2) - random secret used to sign/encrypt session
# JWTs. Generate your own, don't reuse this comment as a value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Real tool-calling execution (Phase 4) - free accounts at pinecone.io and
# dashboard.cohere.com. The Pinecone index is created automatically by
# scripts/ingest-knowledge-base.ts on first run - no manual console step.
PINECONE_API_KEY=
COHERE_API_KEY=
