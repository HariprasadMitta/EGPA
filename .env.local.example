# Real AI Gateway (Phase 10) - a self-hosted LiteLLM Proxy sits in front of
# these 4 providers now (see litellm-config.yaml), so the Next.js app no
# longer reads these directly - only the LiteLLM process does, started via
# .venv-litellm (see the plan file / README for the run command). The
# gateway's own model_list/fallbacks config does what LLM_PROVIDER used to:
# try primary, then fall through the rest in order.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# What the app itself actually talks to - the gateway's endpoint and one
# scoped virtual key (minted once via LITELLM_MASTER_KEY against
# /key/generate - the app never holds a raw provider key). MASTER_KEY is
# only needed for that one-time admin call, not by the running app. In
# production this points at the Gateway hosted via render.yaml, not
# localhost - see README's deployment section.
LITELLM_MASTER_KEY=
LITELLM_BASE_URL=http://localhost:4000
LITELLM_VIRTUAL_KEY=

# Emergency-only escape hatch - real, but a deliberate simplification: if
# the hosted Gateway (render.yaml) is ever unreachable, set this to "true"
# on the deployed app only (never locally) to call OpenRouter directly via
# src/lib/llmDirect.ts instead of through the Gateway. Needs
# OPENROUTER_API_KEY above to be set either way.
LLM_DIRECT_MODE=

# LiteLLM's OWN database (enables real virtual-key issuance/spend tracking)
# - a separate free Postgres project from DATABASE_URL below, not the same
# one Momentum uses.
LITELLM_DATABASE_URL=

# Model Builder (Developer-only page) - Hugging Face OAuth ("Sign in with
# Hugging Face"). Register an app at huggingface.co/settings/applications/new
# with redirect URI matching HF_REDIRECT_URI below. OpenRouter needs no env
# vars here - its PKCE connect flow requires no pre-registered app.
HF_CLIENT_ID=
HF_CLIENT_SECRET=
HF_REDIRECT_URI=http://localhost:3000/api/mlops/hf/callback

# Mirrors of the two public values above - Next.js only exposes NEXT_PUBLIC_*
# vars to the browser, so the client-side "Sign in with Hugging Face" button
# needs its own copies (never put HF_CLIENT_SECRET here).
NEXT_PUBLIC_HF_CLIENT_ID=
NEXT_PUBLIC_HF_REDIRECT_URI=http://localhost:3000/api/mlops/hf/callback

# Database (Phase 1 of the enterprise rearchitecture) - a free Neon Postgres
# connection string from https://neon.tech (project settings -> Connect).
DATABASE_URL=

# Real Neon Monitoring API access for the Observability page's real
# "Database" panel (compute state, CU limits, storage, cumulative
# compute/active time) - generate a key at
# console.neon.tech/app/settings/api-keys, and copy the Project ID from
# that same project's Settings page (must be the project DATABASE_URL
# points at, not a different one if you have more than one).
NEON_API_KEY=
NEON_PROJECT_ID=

# Real authentication (Phase 2) - random secret used to sign/encrypt session
# JWTs. Generate your own, don't reuse this comment as a value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Real tool-calling execution (Phase 4) - free accounts at pinecone.io and
# dashboard.cohere.com. The Pinecone index is created automatically by
# scripts/ingest-knowledge-base.ts on first run - no manual console step.
PINECONE_API_KEY=
COHERE_API_KEY=

# Real live multi-user sync backend - a free Redis database at upstash.com
# (database -> Connect -> copy the rediss:// TCP connection string, not the
# REST URL/token - src/lib/eventBus.ts needs real SUBSCRIBE support, which
# only the TCP protocol gives via ioredis).
REDIS_URL=
